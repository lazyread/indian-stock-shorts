# ── Required ──────────────────────────────────────────────────────────
# Stability AI — for image generation (get key at https://platform.stability.ai)
STABILITY_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Optional: YouTube upload ──────────────────────────────────────────
# Create OAuth credentials at https://console.cloud.google.com/
# App type: "Web application", redirect URI: http://localhost:3000/api/youtube/callback
# YOUTUBE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
# YOUTUBE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
# YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback

# ── Optional: FFmpeg paths (auto-detected if in PATH) ─────────────────
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# ── Optional: Background music ────────────────────────────────────────
# Directory containing background.mp3
# BACKGROUND_MUSIC_PATH=/path/to/music
